# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Only if your key is not scoped to a workspace (Console > Settings > Workspaces)
# ANTHROPIC_WORKSPACE_ID=

# Optional overrides
# BOOKLY_AGENT_MODEL=claude-sonnet-5-5
# BOOKLY_AGENT_EFFORT=low
# BOOKLY_SIM_MODEL=claude-haiku-5-5

# Jev (TypeSafe decision model): only for the experiments in docs/JEV.md. Off unless a flag below is set.
# TYPESAFE_API_KEY=
# BOOKLY_STORE=1                 # customer memory, recommendations and follow-ups
# BOOKLY_RESHIP=1                # with BOOKLY_STORE=1: the reship journey and the order console at /admin
# BOOKLY_ROUTER=1                # with the line below, the intent router runs on Jev
# BOOKLY_ROUTER_ENGINE=jev
